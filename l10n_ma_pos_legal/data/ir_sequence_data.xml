<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Séquence légale Rapport Z
            Format standard Odoo — ne jamais modifier number_next manuellement.
            noupdate="1" : ne sera pas réinitialisée lors des mises à jour du module.
        -->
        <record id="seq_pos_report_z" model="ir.sequence">
            <field name="name">Rapport Z POS — Kodomo Jouet</field>
            <field name="code">pos.report.z</field>
            <field name="prefix">Z/%(year)s/</field>
            <field name="suffix"></field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">False</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
