<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!--
        Héritage de ReceiptHeader pour insérer les mentions légales marocaines
        (ICE, TP, IF) après le logo, dans l'en-tête du ticket thermique.

        Champs disponibles sur order.company grâce à _loader_params_res_company
        dans pos_order.py :
          - company_registry → ICE
          - l10n_ma_tp       → TP (Taxe Professionnelle)
          - l10n_ma_if       → IF (Identifiant Fiscal)
    -->
    <t t-name="l10n_ma_pos_legal.ReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">

        <xpath expr="//img[contains(@class,'pos-receipt-logo')]" position="after">
            <t t-if="order.company.company_registry or order.company.l10n_ma_if or order.company.l10n_ma_tp">
                <div class="text-center" style="font-size: 75%; margin-top: 4px; line-height: 1.6;">
                    <div t-if="order.company.company_registry">
                        ICE : <t t-esc="order.company.company_registry"/>
                    </div>
                    <div t-if="order.company.l10n_ma_tp or order.company.l10n_ma_if">
                        <t t-if="order.company.l10n_ma_tp">TP : <t t-esc="order.company.l10n_ma_tp"/></t><t t-if="order.company.l10n_ma_tp and order.company.l10n_ma_if">   </t><t t-if="order.company.l10n_ma_if">IF : <t t-esc="order.company.l10n_ma_if"/></t>
                    </div>
                </div>
            </t>
        </xpath>

    </t>
</templates>
